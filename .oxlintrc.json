{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/oxlint_v1.90.0/npm/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_meta"
        ]
      }
    ],
    "unicorn/no-array-fill-with-reference-type": "off"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    ".claude-plugin/types/**",
    "evidence/**"
  ]
}
