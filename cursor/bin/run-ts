#!/bin/sh
# Runs cursor/<file>.ts with a Node that can run TypeScript directly (23.6 or later). An app launched from the Dock
# may not have the shell's PATH, and nvm's node is often a shell function, so the usual spots are tried too.
# Exits 3 when there is no such Node.
here=$(cd "$(dirname "$0")/.." && pwd -P)
ok() { "$1" -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>23||(a===23&&b>=6)?0:1)' 2>/dev/null; }
for n in "$(command -v node 2>/dev/null)" $(ls -1d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -rV) /opt/homebrew/bin/node /usr/local/bin/node; do
  if [ -n "$n" ] && [ -x "$n" ] && ok "$n"; then exec "$n" "$here/$1"; fi
done
echo "better: no Node 23.6 or later found (tried PATH, ~/.nvm, /opt/homebrew/bin, /usr/local/bin). Install a current Node, then reload Cursor." >&2
exit 3
